---
import { siteConfig } from "../../config";
import { getGalleryImages } from "../../lib/gallery";
import "../../styles/global.css";

export function getStaticPaths() {
  const projectsWithGallery = siteConfig.projects.filter((p) => p.gallerySlug);
  return projectsWithGallery.map((p) => ({
    params: { slug: p.gallerySlug! },
    props: { project: p, images: getGalleryImages(p.gallerySlug!) },
  }));
}

const { project, images } = Astro.props;
const { accentColor } = siteConfig;
const pageTitle = `${project.name} - Galería`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`Capturas del proyecto ${project.name}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <button
      id="theme-toggle"
      class="fixed top-4 right-4 z-[100] p-2.5 rounded-xl border border-gray-200 bg-white shadow-sm hover:scale-105 transition-all duration-300 cursor-pointer flex items-center justify-center dark:bg-slate-800 dark:border-slate-700"
      aria-label="Cambiar tema"
    >
      <svg id="theme-toggle-sun" class="hidden w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M14 12a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <svg id="theme-toggle-moon" class="w-5 h-5 text-gray-700 dark:text-slate-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
      </svg>
    </button>

    <main class="min-h-screen bg-white dark:bg-slate-900 transition-colors duration-300">
      <header class="max-w-6xl mx-auto px-6 py-10 lg:px-8">
        <nav class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <a
            href="/#projects"
            class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-black transition-colors dark:text-slate-400 dark:hover:text-white"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Volver
          </a>
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-black transition-colors dark:text-slate-400 dark:hover:text-white"
            >
              Ver en GitHub
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          )}
        </nav>

        <div class="mt-10">
          <span class="text-sm font-mono" style={`color: ${accentColor}`}>Galería</span>
          <h1 class="mt-1 text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 dark:text-white">
            {project.name}
          </h1>
          <div class="w-[75px] h-[5px] mt-3 rounded-full" style={`background-color: ${accentColor}`} />
        </div>
      </header>

      <section class="max-w-6xl mx-auto px-6 pb-20 lg:px-8">
        {images.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
            {images.map((src, i) => (
              <button
                type="button"
                data-gallery-img
                data-src={src}
                class="group relative overflow-hidden rounded-xl sm:rounded-2xl border border-gray-200 bg-gray-50 cursor-zoom-in transition-all duration-300 hover:shadow-xl hover:border-gray-300 dark:border-slate-700 dark:bg-slate-800 dark:hover:border-slate-600"
                aria-label={`Ver captura ${i + 1}`}
              >
                <img
                  src={src}
                  alt={`Captura ${i + 1} de ${project.name}`}
                  loading="lazy"
                  class="w-full h-52 sm:h-64 object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </button>
            ))}
          </div>
        ) : (
          <div class="py-24 text-center">
            <div class="mx-auto w-16 h-16 mb-6 flex items-center justify-center rounded-full bg-gray-100 dark:bg-slate-800">
              <svg class="w-8 h-8 text-gray-400 dark:text-slate-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Todavía no hay capturas</h2>
            <p class="mt-2 text-gray-600 dark:text-slate-400">
              Subí los screenshots a la carpeta <code class="text-sm">public/screenshots/{project.gallerySlug}/</code> y reconstruí el sitio.
            </p>
          </div>
        )}
      </section>
    </main>

    <footer class="border-t border-gray-200 dark:border-slate-800">
      <div class="max-w-6xl mx-auto px-6 py-8 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
        <p class="text-sm text-gray-500 dark:text-slate-500">
          © {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
        </p>
        <a
          href="/"
          class="text-sm font-medium text-gray-600 hover:text-black transition-colors dark:text-slate-400 dark:hover:text-white"
        >
          Volver al inicio
        </a>
      </div>
    </footer>

    <div id="lightbox" class="hidden fixed inset-0 z-[200] items-center justify-center bg-black/90 p-4 sm:p-8">
      <button
        id="lightbox-close"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 w-11 h-11 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
        aria-label="Cerrar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <button
        id="lightbox-prev"
        class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
        aria-label="Anterior"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="lightbox-next"
        class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
        aria-label="Siguiente"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <figure class="max-w-4xl w-full">
        <img id="lightbox-img" src="" alt="Captura ampliada" class="max-h-[80vh] w-auto mx-auto rounded-lg shadow-2xl" />
        <figcaption id="lightbox-caption" class="mt-4 text-center text-sm text-white/80"></figcaption>
      </figure>
    </div>

    <script>
      const toggle = document.getElementById("theme-toggle");
      const handleToggle = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");
        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        updateIcons();
      };
      const updateIcons = () => {
        const isDark = document.documentElement.classList.contains("dark");
        const sunIcon = document.getElementById("theme-toggle-sun");
        const moonIcon = document.getElementById("theme-toggle-moon");
        if (isDark) {
          sunIcon?.classList.remove("hidden");
          moonIcon?.classList.add("hidden");
        } else {
          sunIcon?.classList.add("hidden");
          moonIcon?.classList.remove("hidden");
        }
      };
      toggle?.addEventListener("click", handleToggle);
      updateIcons();

      const imgs = Array.from(document.querySelectorAll("[data-gallery-img]"));
      const overlay = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const caption = document.getElementById("lightbox-caption");
      let current = 0;

      const open = (i) => {
        current = i;
        lightboxImg.src = imgs[current].dataset.src;
        caption.textContent = `${current + 1} / ${imgs.length}`;
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        document.body.style.overflow = "";
      };
      const next = () => open((current + 1) % imgs.length);
      const prev = () => open((current - 1 + imgs.length) % imgs.length);

      imgs.forEach((img, i) => img.addEventListener("click", () => open(i)));
      document.getElementById("lightbox-close")?.addEventListener("click", close);
      document.getElementById("lightbox-next")?.addEventListener("click", next);
      document.getElementById("lightbox-prev")?.addEventListener("click", prev);
      overlay?.addEventListener("click", (e) => {
        if (e.target === overlay) close();
      });
      document.addEventListener("keydown", (e) => {
        if (overlay.classList.contains("hidden")) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowRight") next();
        if (e.key === "ArrowLeft") prev();
      });
    </script>
  </body>
</html>

<style is:global>
  html.dark {
    background-color: #0f172a !important;
    color: #f1f5f9 !important;
  }
  html.dark body {
    background-color: #0f172a !important;
    color: #f1f5f9 !important;
  }
</style>
